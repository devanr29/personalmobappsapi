# Server-side env for docker-compose.yml. Copy to .env on the VPS and fill
# in real values (copy them from the Railway dashboard). Never commit .env.

# --- AI / external APIs ---
GEMINI_API_KEY=
GROQ_API_KEY=
NEWS_API_KEY=
API_NINJAS_KEY=

# --- Google ---
GOOGLE_SHEET_ID=
LOG_SHEET_ID=
# One-time seed only; the refreshed token lives in bot_state after the
# Neon data is restored, so this may be left as-is from Railway.
GOOGLE_TOKEN_B64=

# --- App ---
MOBILE_API_TOKEN=
WALLET_API_TOKEN=
LOG_SECRET=
# 0 until cutover (so the VPS and Railway don't both fire pushes), then 1.
ENABLE_SCHEDULER=0

# --- Postgres (local container) ---
POSTGRES_USER=nocturne
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=nocturne

# --- Caddy ---
# Your VPS IP with dashes, e.g. 203-0-113-10.sslip.io
API_HOST=
