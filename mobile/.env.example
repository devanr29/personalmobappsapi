# Copy to .env.local and fill in real values (that file is gitignored).
# Base URL of the locally running Flask backend — this is only the
# build-time default. Settings > API Server (in the app) can override it
# per-install at runtime without a rebuild — see api/client.ts's
# getApiUrl/setApiUrlOverride.
# Physical device: your machine's LAN IP, e.g. http://192.168.1.23:5000
# Android emulator: http://10.0.2.2:5000
# iOS simulator: http://localhost:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# Must match MOBILE_API_TOKEN in the backend's environtment.env.
EXPO_PUBLIC_API_TOKEN=
